# Copy to deploy/.env and fill in secrets before: docker compose --env-file .env -f docker-compose.ghcr.yml up -d
#
# GHCR images (after CI publish):
#   ghcr.io/<GHCR_OWNER>/vibe-kanban-cloud  — projects, kanban, auth, Postgres sync
#   ghcr.io/<GHCR_OWNER>/vibe-kanban         — local agent server (workspaces)

GHCR_OWNER=tasaankaeris
# Must match a git tag published by Docker GHCR (Create pre-release tag workflow), e.g. v0.1.43-fork.1-20260528180301
IMAGE_TAG=v0.1.43-fork.1-20260528180301

# Required — generate with: openssl rand -base64 48
VIBEKANBAN_REMOTE_JWT_SECRET=

# Required for ElectricSQL replication user
ELECTRIC_ROLE_PASSWORD=change-me

# Public URL of the cloud API/UI (browser + OAuth callbacks)
PUBLIC_BASE_URL=http://localhost:3000

# Solo self-host login (no GitHub/Google OAuth setup)
SELF_HOST_LOCAL_AUTH_EMAIL=admin@example.com
SELF_HOST_LOCAL_AUTH_PASSWORD=change-me

# Optional OAuth (use instead of SELF_HOST_* if you prefer)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Host ports
CLOUD_PORT=3000
LOCAL_PORT=3001
